{
    "manifest_version":  3,
    "name":  "WhatsApp Bulk Sender from Excel",
    "version":  "1.0.0",
    "description":  "Send personalized WhatsApp messages and optional images to contacts imported from Excel (.xlsx, .xls) files.",
    "permissions":  [
                        "storage",
                        "tabs",
                        "activeTab",
                        "scripting",
                        "alarms"
                    ],
    "host_permissions":  [
                             "https://web.whatsapp.com/*",
                             "http://127.0.0.1/*"
                         ],
    "background":  {
                       "service_worker":  "background/service-worker.js"
                   },
    "action":  {
                   "default_popup":  "popup/popup.html",
                   "default_icon":  {
                                        "16":  "assets/icon16.png",
                                        "48":  "assets/icon48.png",
                                        "128":  "assets/icon128.png"
                                    }
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://web.whatsapp.com/*"
                                            ],
                                "js":  [
                                           "content/whatsapp.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "icons":  {
                  "16":  "assets/icon16.png",
                  "48":  "assets/icon48.png",
                  "128":  "assets/icon128.png"
              },
    "minimum_chrome_version":  "116"
}